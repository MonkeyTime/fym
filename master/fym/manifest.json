{
  "name": "FYM - Free Your Mind",
  "version": "0.3.1",
  "manifest_version": 3,
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "storage"
  ],
  "options_page": "options.html",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "fym.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:"
  }
}
